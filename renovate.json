{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePatch"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Pin Dockerfile images by digest and merge after CI passes",
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "platformAutomerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackagePatterns": ["*"],
      "semanticCommitType": "chore"
    },
    {
      "matchPackagePatterns": ["vite*", "@vitejs/*", "tailwindcss", "@tailwindcss/*"],
      "groupName": "frontend tools"
    }
  ]
}
